prepare_community_matrix <- function(
    Land_traits,
    species_col = "FAO_Code",
    season_cols = c("Autumn", "Winter", "Spring", "Summer"),
    season_levels = c("Autumn", "Winter", "Spring", "Summer")
) {
  
  missing_cols <- setdiff(c(species_col, season_cols), names(Land_traits))
  
  if (length(missing_cols) > 0) {
    stop(
      "The following columns are missing from Land_traits: ",
      paste(missing_cols, collapse = ", ")
    )
  }
  
  comm_df <- Land_traits %>%
    dplyr::select(
      dplyr::all_of(species_col),
      dplyr::all_of(season_cols)
    ) %>%
    dplyr::distinct(.data[[species_col]], .keep_all = TRUE)
  
  comm_df <- as.data.frame(comm_df)
  rownames(comm_df) <- comm_df[[species_col]]
  comm_df[[species_col]] <- NULL
  
  comm_mat <- as.matrix(comm_df)
  storage.mode(comm_mat) <- "numeric"
  
  # Convert species x seasons to seasons x species.
  Mat2_use <- t(comm_mat)
  
  Mat2_use <- Mat2_use[season_levels, , drop = FALSE]
  
  # Remove species with zero abundance across all seasons.
  Mat2_use <- Mat2_use[, colSums(Mat2_use, na.rm = TRUE) > 0, drop = FALSE]
  
  Mat2_use[is.na(Mat2_use)] <- 0
  
  Mat2_use
}

