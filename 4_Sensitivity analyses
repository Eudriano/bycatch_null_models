prepare_trait_matrix <- function(
    Land_traits,
    trait_cols,
    species_col = "FAO_Code",
    cat_traits,
    cont_traits,
    rescale_continuous = FALSE
) {
  
  missing_cols <- setdiff(c(species_col, trait_cols), names(Land_traits))
  
  if (length(missing_cols) > 0) {
    stop(
      "The following columns are missing from Land_traits: ",
      paste(missing_cols, collapse = ", ")
    )
  }
  
  trait_df <- Land_traits %>%
    dplyr::select(
      dplyr::all_of(species_col),
      dplyr::all_of(trait_cols)
    ) %>%
    dplyr::distinct(.data[[species_col]], .keep_all = TRUE)
  
  trait_df <- as.data.frame(trait_df)
  rownames(trait_df) <- trait_df[[species_col]]
  trait_df[[species_col]] <- NULL
  
  cat_use <- intersect(cat_traits, trait_cols)
  cont_use <- intersect(cont_traits, trait_cols)
  
  for (cc in cat_use) {
    trait_df[[cc]] <- factor(trait_df[[cc]])
  }
  
  for (cc in cont_use) {
    trait_df[[cc]] <- as.numeric(trait_df[[cc]])
    
    # In the shown Land_traits object, continuous traits already appear to be
    # standardized to 0-1. Therefore, rescale_continuous is FALSE by default.
    # Set TRUE only if raw trait values are used.
    if (rescale_continuous) {
      trait_df[[cc]] <- range01(trait_df[[cc]])
    }
  }
  
  if (any(!stats::complete.cases(trait_df))) {
    bad_sp <- rownames(trait_df)[!stats::complete.cases(trait_df)]
    stop(
      "Missing values in the trait matrix for species: ",
      paste(bad_sp, collapse = ", ")
    )
  }
  
  trait_df
}

