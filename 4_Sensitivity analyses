format_elapsed_time <- function(seconds) {
  
  seconds <- as.numeric(seconds)
  
  if (is.na(seconds)) return(NA_character_)
  
  h <- floor(seconds / 3600)
  m <- floor((seconds %% 3600) / 60)
  s <- round(seconds %% 60, 2)
  
  sprintf("%02d:%02d:%05.2f", h, m, s)
}

get_fd_theme <- function() {
  
  # Uses the manuscript/custom theme if available.
  # Otherwise, falls back to a clean default ggplot theme.
  
  if (exists("FD_theme2", mode = "function")) {
    FD_theme2()
  } else {
    ggplot2::theme_bw()
  }
}

check_fd_inputs <- function(Mat2_use, coord_use) {
  
  if (is.null(rownames(Mat2_use))) {
    stop("Mat2_use must have season names as row names.")
  }
  
  if (is.null(colnames(Mat2_use))) {
    stop("Mat2_use must have species names as column names.")
  }
  
  if (is.null(rownames(coord_use))) {
    stop("coord_use must have species names as row names.")
  }
  
  missing_coords <- setdiff(colnames(Mat2_use), rownames(coord_use))
  
  if (length(missing_coords) > 0) {
    stop(
      "The following species occur in Mat2_use but are absent from coord_use: ",
      paste(missing_coords, collapse = ", ")
    )
  }
  
  invisible(TRUE)
}

#==============================================================================
# 3. FD calculation for one assemblage
#==============================================================================

compute_fd_one_assemblage <- function(abund_vec_named, coords_mat) {
  
  # This function computes FRic, FEve, and FDiv for a single assemblage.
  #
  # Important:
  # FRic in a k-dimensional space requires at least k + 1 species. Therefore,
  # in a 4D functional space, at least five species are required.
  
  abund_vec_named <- abund_vec_named[abund_vec_named > 0]
  
  sp_use <- intersect(names(abund_vec_named), rownames(coords_mat))
  
  if (length(sp_use) == 0) {
    return(c(FRic = NA_real_, FEve = NA_real_, FDiv = NA_real_))
  }
  
  abund_use <- abund_vec_named[sp_use]
  coords_sub <- coords_mat[sp_use, , drop = FALSE]
  
  if (length(sp_use) <= ncol(coords_sub)) {
    return(c(FRic = NA_real_, FEve = NA_real_, FDiv = NA_real_))
  }
  
  comm <- matrix(
    abund_use,
    nrow = 1,
    dimnames = list("assemblage", sp_use)
  )
  
  fd_res <- tryCatch(
    FD::dbFD(
      x          = coords_sub,
      a          = comm,
      calc.FRic  = TRUE,
      stand.x    = FALSE,
      corr       = "none",
      m          = ncol(coords_sub),
      w.abun     = TRUE,
      messages   = FALSE
    ),
    error = function(e) NULL
  )
  
  if (is.null(fd_res)) {
    return(c(FRic = NA_real_, FEve = NA_real_, FDiv = NA_real_))
  }
  
  c(
    FRic = as.numeric(fd_res$FRic["assemblage"]),
    FEve = as.numeric(fd_res$FEve["assemblage"]),
    FDiv = as.numeric(fd_res$FDiv["assemblage"])
  )
}

#==============================================================================
# 4. Observed FD table
#==============================================================================

compute_observed_fd_table <- function(Mat2_use, coord_use) {
  
  Mat2_use <- as.matrix(Mat2_use)
  coord_use <- as.matrix(coord_use)
  
  storage.mode(Mat2_use) <- "numeric"
  storage.mode(coord_use) <- "numeric"
  
  check_fd_inputs(Mat2_use, coord_use)
  
  obs_list <- lapply(rownames(Mat2_use), function(seas) {
    
    fd_tmp <- compute_fd_one_assemblage(
      abund_vec_named = Mat2_use[seas, ],
      coords_mat = coord_use
    )
    
    data.frame(
      Assemblage = seas,
      FRic_abs = fd_tmp["FRic"],
      FEve = fd_tmp["FEve"],
      FDiv = fd_tmp["FDiv"],
      row.names = NULL
    )
  })
  
  dplyr::bind_rows(obs_list)
}

extract_observed_values <- function(FD_all, assemblage_name) {
  
  obs_row <- FD_all %>%
    dplyr::filter(Assemblage == assemblage_name)
  
  if (nrow(obs_row) != 1) {
    stop("FD_all must contain exactly one row for assemblage: ", assemblage_name)
  }
  
  fric_col <- NULL
  
  if ("FRic_abs" %in% names(obs_row)) {
    fric_col <- "FRic_abs"
  }
  
  if (is.null(fric_col) && "FRic" %in% names(obs_row)) {
    fric_col <- "FRic"
  }
  
  if (is.null(fric_col)) {
    stop("FD_all must contain either FRic_abs or FRic.")
  }
  
  c(
    FRic = as.numeric(obs_row[[fric_col]]),
    FEve = as.numeric(obs_row$FEve),
    FDiv = as.numeric(obs_row$FDiv)
  )
}

#==============================================================================
# 5. Null-model summary function
#==============================================================================

summarise_null_result <- function(obs_value, null_values) {
  
  null_values <- null_values[is.finite(null_values)]
  
  if (length(null_values) == 0 || !is.finite(obs_value)) {
    return(data.frame(
      Observed  = obs_value,
      Null_mean = NA_real_,
      Null_sd   = NA_real_,
      SES       = NA_real_,
      p_two     = NA_real_,
      n_valid   = length(null_values)
    ))
  }
  
  null_mu <- mean(null_values)
  null_sd <- stats::sd(null_values)
  
  SES <- ifelse(
    is.finite(null_sd) && null_sd > 0,
    (obs_value - null_mu) / null_sd,
    NA_real_
  )
  
  # Two-sided permutation p-value centred on the null mean.
  # The +1 correction avoids zero p-values when permutations are randomly drawn.
  p_two <- (
    sum(abs(null_values - null_mu) >= abs(obs_value - null_mu)) + 1
  ) / (
    length(null_values) + 1
  )
  
  data.frame(
    Observed  = obs_value,
    Null_mean = null_mu,
    Null_sd   = null_sd,
    SES       = SES,
    p_two     = p_two,
    n_valid   = length(null_values)
  )
}

#==============================================================================
# 6. Reviewer #1: trait-profile shuffle null model
#==============================================================================

run_trait_profile_shuffle <- function(
    Mat2_use,
    coord_use,
    FD_all = NULL,
    n_perm = 999,
    seed = 123,
    season_levels = c("Autumn", "Winter", "Spring", "Summer"),
    show_progress = TRUE,
    progress_label = "Trait-profile shuffle"
) {
  
  start_time <- Sys.time()
  
  set.seed(seed)
  
  Mat2_use <- as.matrix(Mat2_use)
  coord_use <- as.matrix(coord_use)
  
  storage.mode(Mat2_use) <- "numeric"
  storage.mode(coord_use) <- "numeric"
  
  check_fd_inputs(Mat2_use, coord_use)
  
  if (is.null(FD_all)) {
    FD_all <- compute_observed_fd_table(Mat2_use, coord_use)
  }
  
  seasons <- rownames(Mat2_use)
  metrics <- c("FRic", "FEve", "FDiv")
  
  total_steps <- length(seasons) * n_perm
  progress_i <- 0
  
  if (show_progress) {
    message("\nRunning: ", progress_label)
    pb <- utils::txtProgressBar(
      min = 0,
      max = total_steps,
      style = 3
    )
    on.exit(close(pb), add = TRUE)
  } else {
    pb <- NULL
  }
  
  sensitivity_list <- vector("list", length(seasons))
  names(sensitivity_list) <- seasons
  
  for (s in seq_along(seasons)) {
    
    seas <- seasons[s]
    
    # Observed CPUE vector for the season.
    # This is retained exactly as observed.
    abund_obs <- Mat2_use[seas, ]
    abund_obs <- abund_obs[abund_obs > 0]
    
    # Observed FD values.
    obs_values <- extract_observed_values(
      FD_all = FD_all,
      assemblage_name = seas
    )
    
    sim_values <- matrix(
      NA_real_,
      nrow = n_perm,
      ncol = length(metrics),
      dimnames = list(NULL, metrics)
    )
    
    for (i in seq_len(n_perm)) {
      
      # Core randomization:
      # Complete functional profiles are shuffled among species.
      #
      # This preserves:
      #   1. observed species composition;
      #   2. observed seasonal richness;
      #   3. observed CPUE values;
      #   4. the empirical shape of the functional-trait space.
      #
      # This breaks:
      #   1. the link between species identity and functional position.
      #
      # Complete functional profiles are shuffled instead of individual traits
      # because independent trait shuffling may create biologically unrealistic
      # trait combinations.
      
      coords_perm <- coord_use[sample(rownames(coord_use)), , drop = FALSE]
      rownames(coords_perm) <- rownames(coord_use)
      
      sim_values[i, ] <- compute_fd_one_assemblage(
        abund_vec_named = abund_obs,
        coords_mat = coords_perm
      )
      
      progress_i <- progress_i + 1
      
      if (!is.null(pb)) {
        utils::setTxtProgressBar(pb, progress_i)
      }
    }
    
    metric_results <- lapply(metrics, function(met) {
      
      tmp <- summarise_null_result(
        obs_value = obs_values[met],
        null_values = sim_values[, met]
      )
      
      data.frame(
        Season = seas,
        Metric = met,
        tmp,
        row.names = NULL
      )
    })
    
    sensitivity_list[[s]] <- dplyr::bind_rows(metric_results)
  }
  
  end_time <- Sys.time()
  elapsed_seconds <- as.numeric(difftime(end_time, start_time, units = "secs"))
  
  sensitivity_results <- dplyr::bind_rows(sensitivity_list) %>%
    dplyr::mutate(
      p_adj_Holm = stats::p.adjust(p_two, method = "holm"),
      Significant = dplyr::case_when(
        is.na(p_adj_Holm) ~ NA_character_,
        p_adj_Holm < 0.05 ~ "Yes",
        TRUE ~ "No"
      ),
      Direction = dplyr::case_when(
        is.na(SES) ~ NA_character_,
        SES > 0 ~ "Observed > null",
        SES < 0 ~ "Observed < null",
        TRUE ~ "Observed = null"
      ),
      Season = factor(Season, levels = season_levels)
    ) %>%
    dplyr::arrange(Metric, Season)
  
  runtime_tbl <- data.frame(
    Analysis = progress_label,
    Start_time = start_time,
    End_time = end_time,
    Runtime_seconds = elapsed_seconds,
    Runtime_hms = format_elapsed_time(elapsed_seconds),
    n_perm = n_perm,
    n_steps = total_steps
  )
  
  attr(sensitivity_results, "runtime") <- runtime_tbl
  
  message(
    "\nFinished: ", progress_label,
    " | elapsed time = ", format_elapsed_time(elapsed_seconds)
  )
  
  sensitivity_results
}

#==============================================================================
# 7. Reviewer #2: build functional space for alternative trait sets
#==============================================================================

build_trait_space <- function(
    trait_df,
    species_col,
    traits_use,
    pcoa_k = 4
) {
  
  missing_traits <- setdiff(traits_use, names(trait_df))
  
  if (length(missing_traits) > 0) {
    stop(
      "The following traits are absent from trait_df: ",
      paste(missing_traits, collapse = ", ")
    )
  }
  
  if (!species_col %in% names(trait_df)) {
    stop("species_col was not found in trait_df.")
  }
  
  trait_sub <- trait_df %>%
    dplyr::select(dplyr::all_of(c(species_col, traits_use))) %>%
    as.data.frame()
  
  # Remove incomplete trait rows.
  incomplete_rows <- !stats::complete.cases(trait_sub)
  
  if (any(incomplete_rows)) {
    warning(
      "Some species had missing trait values and were removed: ",
      paste(trait_sub[[species_col]][incomplete_rows], collapse = ", ")
    )
    
    trait_sub <- trait_sub[!incomplete_rows, , drop = FALSE]
  }
  
  trait_mat <- trait_sub[, traits_use, drop = FALSE]
  rownames(trait_mat) <- trait_sub[[species_col]]
  
  # Convert character traits to factors for Gower distance.
  trait_mat[] <- lapply(trait_mat, function(x) {
    if (is.character(x)) {
      as.factor(x)
    } else {
      x
    }
  })
  
  gower_dist <- FD::gowdis(trait_mat)
  
  k_use <- min(pcoa_k, nrow(trait_mat) - 1)
  
  pcoa_res <- stats::cmdscale(
    d = gower_dist,
    eig = TRUE,
    k = k_use
  )
  
  coord <- as.matrix(pcoa_res$points)
  colnames(coord) <- paste0("PCoA", seq_len(ncol(coord)))
  
  eig <- pcoa_res$eig
  
  if (any(eig[seq_len(k_use)] < -1e-8, na.rm = TRUE)) {
    warning(
      "At least one selected PCoA axis has a negative eigenvalue. ",
      "Check whether this differs from the ordination procedure used in the ",
      "main manuscript analysis."
    )
  }
  
  list(
    coord = coord,
    gower_dist = gower_dist,
    eig = eig,
    traits_used = traits_use,
    n_traits = length(traits_use),
    n_species = nrow(coord)
  )
}

#==============================================================================
# 8. Reviewer #2: trait-set sensitivity analysis
#==============================================================================

run_trait_set_sensitivity <- function(
    trait_df,
    species_col,
    trait_sets,
    Mat2_use,
    n_perm = 999,
    seed = 123,
    pcoa_k = 4,
    season_levels = c("Autumn", "Winter", "Spring", "Summer"),
    show_progress = TRUE
) {
  
  start_time_total <- Sys.time()
  
  Mat2_use <- as.matrix(Mat2_use)
  storage.mode(Mat2_use) <- "numeric"
  
  scenario_results <- vector("list", length(trait_sets))
  names(scenario_results) <- names(trait_sets)
  
  scenario_runtime <- vector("list", length(trait_sets))
  names(scenario_runtime) <- names(trait_sets)
  
  for (sc in names(trait_sets)) {
    
    traits_use <- trait_sets[[sc]]
    
    message("\nPreparing trait-set scenario: ", sc)
    message("Traits used: ", paste(traits_use, collapse = ", "))
    
    trait_space <- build_trait_space(
      trait_df = trait_df,
      species_col = species_col,
      traits_use = traits_use,
      pcoa_k = pcoa_k
    )
    
    coord_tmp <- trait_space$coord
    
    sp_common <- intersect(colnames(Mat2_use), rownames(coord_tmp))
    
    if (length(sp_common) <= pcoa_k) {
      stop(
        "Scenario ", sc, " has too few species shared between Mat2_use and ",
        "the reconstructed trait space."
      )
    }
    
    missing_from_traits <- setdiff(colnames(Mat2_use), rownames(coord_tmp))
    
    if (length(missing_from_traits) > 0) {
      warning(
        "Scenario ", sc, ": the following species were absent from the trait ",
        "space and were removed from Mat2_use: ",
        paste(missing_from_traits, collapse = ", ")
      )
    }
    
    Mat2_tmp <- Mat2_use[, sp_common, drop = FALSE]
    coord_tmp <- coord_tmp[sp_common, , drop = FALSE]
    
    # Observed FD values are recalculated for each trait-set scenario because
    # changing the traits changes the geometry of the functional space.
    FD_obs_tmp <- compute_observed_fd_table(
      Mat2_use = Mat2_tmp,
      coord_use = coord_tmp
    )
    
    scenario_label <- paste0("Trait-set sensitivity: ", sc)
    
    sens_tmp <- run_trait_profile_shuffle(
      Mat2_use = Mat2_tmp,
      coord_use = coord_tmp,
      FD_all = FD_obs_tmp,
      n_perm = n_perm,
      seed = seed,
      season_levels = season_levels,
      show_progress = show_progress,
      progress_label = scenario_label
    ) %>%
      dplyr::mutate(
        Scenario = sc,
        n_traits = trait_space$n_traits,
        Traits = paste(traits_use, collapse = ", ")
      )
    
    scenario_results[[sc]] <- sens_tmp
    
    runtime_tmp <- attr(sens_tmp, "runtime") %>%
      dplyr::mutate(
        Scenario = sc,
        n_traits = trait_space$n_traits,
        Traits = paste(traits_use, collapse = ", ")
      )
    
    scenario_runtime[[sc]] <- runtime_tmp
  }
  
  end_time_total <- Sys.time()
  total_elapsed <- as.numeric(
    difftime(end_time_total, start_time_total, units = "secs")
  )
  
  results <- dplyr::bind_rows(scenario_results)
  
  runtime_tbl <- dplyr::bind_rows(scenario_runtime)
  
  total_runtime_tbl <- data.frame(
    Analysis = "Trait-set sensitivity: total",
    Start_time = start_time_total,
    End_time = end_time_total,
    Runtime_seconds = total_elapsed,
    Runtime_hms = format_elapsed_time(total_elapsed),
    n_perm = n_perm,
    n_steps = NA_integer_,
    Scenario = "Total",
    n_traits = NA_integer_,
    Traits = NA_character_
  )
  
  runtime_tbl <- dplyr::bind_rows(runtime_tbl, total_runtime_tbl)
  
  attr(results, "runtime") <- runtime_tbl
  
  message(
    "\nFinished trait-set sensitivity analysis",
    " | total elapsed time = ", format_elapsed_time(total_elapsed)
  )
  
  results
}

